{
  "name": "postcss-filter-progid",
  "version": "2.0.0",
  "description": "PostCSS plugin to remove legacy IE filter and progid declarations from CSS. Perfect for WordPress theme builds and modern CSS cleanup.",
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "filter",
    "legacy",
    "progid",
    "ie",
    "internet-explorer",
    "wordpress",
    "theme",
    "build",
    "cleanup",
    "alpha",
    "ms-filter"
  ],
  "author": "Dave England <DavidEngland@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidEngland/postcss-filter-progid.git"
  },
  "bugs": {
    "url": "https://github.com/DavidEngland/postcss-filter-progid/issues"
  },
  "homepage": "https://github.com/DavidEngland/postcss-filter-progid#readme",
  "main": "index.js",
  "engines": {
    "node": ">=12.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-postcss": "^4.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.32"
  },
  "scripts": {
    "test": "jest && eslint *.js",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "prepublishOnly": "npm test"
  },
  "files": [
    "index.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "eslintConfig": {
    "extends": "eslint-config-postcss",
    "env": {
      "jest": true,
      "node": true,
      "es6": true
    },
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.js"
    ]
  }
}